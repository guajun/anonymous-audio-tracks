    "entry": "scripts/run_inference.py",
    "weights": {
      "distributed": false,
      "local_layout": ["model-cache/sam-audio-small/checkpoint.pt", "model-cache/sam-audio-small/config.json", "model-cache/t5-base/model.safetensors", "model-cache/t5-base/config.json"],
      "integrity": "upstream model-manifest.json + scripts/verify_models.py；永不自动下载"
    }
  },
  "bridge": {
    "kind": "explicit project-local extension (NOT Pi-native audio; Pi 0.87.1 native audio = unsupported)",
    "frozen_in": "agentic/audio-probe/README.md §9 (issue #30)",
    "files": [
      {
        "source": "agentic/audio-probe/bridge/audio-bridge.ts",
        "install_path": ".pi/extensions/audio-bridge.ts",
        "sha256": "3c011dc1fb22a28d4fb02e26803d85bd56f0b85706c4b869070b9f464f7c0bed",
        "role": "Pi extension (audio_attach tool + context injection)"
      },
      {
        "source": "agentic/audio-probe/bridge/audio_guard.mjs",
        "install_path": ".pi/extensions/audio_guard.mjs",
        "sha256": "1bb74cff5fe816899982baa8d2d1d81e9fb6f41ed4a5cc3ce5327d66a6728ceb",
        "role": "纯校验模块（audio-bridge.ts 的同目录依赖，必须一起部署）"
      }
    ],
    "loaded_via": ".pi/settings.json -> extensions: [\"extensions/audio-bridge.ts\"] (project trust required)",
    "tool": {
      "name": "audio_attach",
      "args": {"path": "relative to PI_AUDIO_BRIDGE_ROOT (workspace: audio/inputs)"},
      "success_json": ["attached", "mime", "bytes", "sha256", "queueDepth", "queuedBytes", "note"],
      "error_codes": ["E_AUDIO_ARGS", "E_AUDIO_PATH", "E_AUDIO_NOT_FOUND", "E_AUDIO_NOT_FILE", "E_AUDIO_SIZE", "E_AUDIO_QUEUE", "E_AUDIO_MIME", "E_AUDIO_READ", "E_AUDIO_MODEL"]
    },
    "env": {
      "PI_AUDIO_BRIDGE_ROOT": "workspace audio/inputs 目录（run.ps1/run.sh/smoke.py 设置；不设置时默认指向 audio-probe/fixtures，不适合本 workspace）",
      "PI_AUDIO_BRIDGE_MAX_BYTES": "单文件上限（默认 4 MiB）",
      "PI_AUDIO_BRIDGE_MAX_QUEUE_BYTES": "排队上限（默认 8 MiB）"
    }
  },
  "trust": {
    "mode": "per-process `pi --approve`（run 脚本固定携带）",
    "persists_global_state": false,
    "note": "不修改 ~/.pi/agent/trust.json、不修改全局 settings/认证；交互式用户可用 /trust 自行持久化（本模板不代做）。实证：.pi/settings.json 的 extensions 在 --approve 下加载、--no-approve 下不加载。"
  },
  "workspace": {
    "default_path": "<repo>/.local/agentic/workspace (gitignored)",
    "layout": [
      "AGENTS.md",
      ".pi/settings.json",
      ".pi/extensions/audio-bridge.ts",
      ".pi/skills/sam-audio/ (gh skill install, pinned)",
      "audio/inputs/ (输入音频 + manifest.json)",
      "outputs/ (outputs/result.json + outputs/runs/<run-id>/)",
      "local/ (本机配置/证据；不提交)",
      "sessions/ (Pi sessionDir，workspace 本地)",
      "run.ps1 / run.sh"
    ],
    "outputs": {
      "result_json": "outputs/result.json",
      "runs_dir": "outputs/runs/<run-id>/",
      "schema": {"owner": "guajun/anonymous-audio-tracks#32", "status": "parallel, not owned here", "note": "本项只约定路径；不发明 schema。schema 合并前 Agent 写 outputs/notes.md 与 runs 产物，不自造 schema 并宣称兼容。"}
    },
    "audio_manifest": {
      "path": "audio/inputs/manifest.json",
      "schema": "workspace-audio-manifest/v1",
      "fields": ["name", "sha256", "bytes", "format", "duration_s", "sample_rate", "channels", "probe", "source"]
    }
  },
  "constraints": {
    "no_gpu_inference": "deferred to guajun/anonymous-audio-tracks#33",
    "no_weights_audio_keys_paths_in_git": true,
    "root_lockfiles_touched": false,
    "global_settings_auth_untouched": true,
    "sam_network": "disabled (HF_HUB_OFFLINE=1 / TRANSFORMERS_OFFLINE=1 in upstream wrapper); 禁止自动下载权重"
  }
}
