    "install_command": "gh skill install guajun/agentic-audio-toolbox sam-audio --agent pi --scope project --pin dfbc40a9541f686207b65b93b1332bb505654261",
    "installed_files": [".pi/skills/sam-audio/SKILL.md", ".pi/skills/sam-audio/references/cli-reference.md", ".pi/skills/sam-audio/scripts/audio_toolbox.py"],
    "cli_schema": "audio-toolbox.sam/v1",
    "cli_exit_codes": {"0": "success", "2": "usage", "3": "input", "4": "environment", "5": "upstream-failed", "6": "timeout", "7": "output"}
  },
  "sam_source": {
    "repository": "guajun/anonymous-audio-tracks",
    "path": "infrastructure/audio-analysis/sam-audio",
