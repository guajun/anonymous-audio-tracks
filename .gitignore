# Credentials and machine-specific settings
.env
.env.*
!.env.example
.local/
*.pem
*.key
*.p12
*.pfx

# Python and environments
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Generated or externally sourced assets
data/
datasets/
models/
checkpoints/
cache/
runs/
outputs/
logs/
wandb/
# Source and test packages literally named "data" are tracked; generated
# data/ directories elsewhere (and compiled caches) stay ignored.
!src/aat/data/
!src/aat/data/*.py
!tests/data/
!tests/data/*.py

# Migrated Gemini JSON history is small, text-only provenance; future local
# model/audio artifacts remain ignored by the rules above.
!infrastructure/audio-analysis/gemini/history/
!infrastructure/audio-analysis/gemini/history/runs/
!infrastructure/audio-analysis/gemini/history/runs/**

# Keep the audio-data contract documented while ignoring the actual media.
!data/
/data/*
!data/README.md
!data/audio-analysis/
/data/audio-analysis/*
!data/audio-analysis/README.md
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.mid
*.midi
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.safetensors
*.fxp
*.vstpreset

# Source directories whose names collide with the asset rule above.
!src/aat/models/
!tests/models/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
